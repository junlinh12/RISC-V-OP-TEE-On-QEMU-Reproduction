-- files that print the '[BR] ... override enabled' messages --

--- ./local.mk (161 lines)
################################################################################
# Common function for preparing git repos (clone/fetch/checkout/submodule)
# Usage：
#   $(call PREPARE_GIT_TREE,<SRCDIR>,<GITURL>,<BRANCH>,<NAME>)
################################################################################

define PREPARE_GIT_TREE
	@echo "==== $(4) Dev Tree ===="
	@mkdir -p $(1)
	@if [ ! -d $(1)/.git ]; then \
		echo "[BR] $(4) dev tree not found. Cloning..."; \
		git clone --recursive $(2) $(1); \
	else \
		echo "[BR] $(4) dev tree exists. Fetching updates..."; \
		cd $(1) && git fetch --all --tags; \
	fi; \
	echo "[BR] Checking out $(3)..."; \
	cd $(1) && git checkout $(3); \
	echo "[BR] Updating submodules (if any)..."; \
	cd $(1) && git submodule update --init --recursive
endef

################################################################################
# Custom QEMU git repo source tree
################################################################################

CUSTOM_QEMU_SRCDIR  = $(TOPDIR)/custom/qemu
CUSTOM_QEMU_GITURL  = https://gitlab.com/riseproject/riscv-optee/qemu.git
CUSTOM_QEMU_BRANCH  = rp016_m1

# Add QEMU prepare function to the pre-rsync hooks
define CUSTOM_QEMU_PREPARE
	$(call PREPARE_GIT_TREE,$(CUSTOM_QEMU_SRCDIR),$(CUSTOM_QEMU_GITURL),$(CUSTOM_QEMU_BRANCH),QEMU)
endef
HOST_QEMU_PRE_RSYNC_HOOKS += CUSTOM_QEMU_PREPARE

# Override the original QEMU source tree
QEMU_OVERRIDE_SRCDIR = $(CUSTOM_QEMU_SRCDIR)

# -----------------------------------------------------------------------------
# Wrap ./configure，ti disable GIT_DIR
# At host-qemu configure stage,
# Buildroot does 'GIT_DIR=. PATH=... ./configure ...',
# and leads to Meson's subprojects (e.g. keycodemapdb / berkeley-softfloat-3)
# run 'git checkout' under bare repo mode and causes error:
# 'fatal: this operation must be run in a work tree'.
#
# Solve this with a configure wrapper to unset the GIT_DIR without any impact
# to other packages.
# -----------------------------------------------------------------------------
define HOST_QEMU_FIX_GITDIR_CONFIGURE_WRAPPER
	@echo "[BR] Installing host-qemu configure wrapper to ignore GIT_DIR..."
	@cd $(@D) && \
	if [ -x configure ] && [ ! -x configure.real ]; then \
		mv configure configure.real; \
		printf '%s\n' '#!/bin/sh' 'unset GIT_DIR' 'exec "$$0.real" "$$@"' > configure; \
		chmod +x configure; \
	fi
endef

# Add it to the pre-configure hooks
HOST_QEMU_PRE_CONFIGURE_HOOKS += HOST_QEMU_FIX_GITDIR_CONFIGURE_WRAPPER

################################################################################
# Custom OpenSBI git repo source tree
################################################################################

CUSTOM_OPENSBI_SRCDIR  = $(TOPDIR)/custom/opensbi
CUSTOM_OPENSBI_GITURL  = https://gitlab.com/riseproject/riscv-optee/opensbi.git
CUSTOM_OPENSBI_BRANCH  = rp016_m1

# Add openSBI prepare function to the pre-rsync hooks
define CUSTOM_OPENSBI_PREPARE
	$(call PREPARE_GIT_TREE,$(CUSTOM_OPENSBI_SRCDIR),$(CUSTOM_OPENSBI_GITURL),$(CUSTOM_OPENSBI_BRANCH),OpenSBI)
endef
OPENSBI_PRE_RSYNC_HOOKS   += CUSTOM_OPENSBI_PREPARE

# Override the original openSBI source tree
OPENSBI_OVERRIDE_SRCDIR    = $(CUSTOM_OPENSBI_SRCDIR)

################################################################################
# Custom OP-TEE OS git repo source tree
################################################################################

CUSTOM_OPTEE_OS_SRCDIR  = $(TOPDIR)/custom/optee-os
CUSTOM_OPTEE_OS_GITURL  = https://gitlab.com/riseproject/riscv-optee/optee_os.git
CUSTOM_OPTEE_OS_BRANCH  = rp016_m1

# Add OP-TEE OS prepare function to the pre-rsync hooks
define CUSTOM_OPTEE_OS_PREPARE
	$(call PREPARE_GIT_TREE,$(CUSTOM_OPTEE_OS_SRCDIR),$(CUSTOM_OPTEE_OS_GITURL),$(CUSTOM_OPTEE_OS_BRANCH),OP-TEE_OS)
endef
OPTEE_OS_PRE_RSYNC_HOOKS += CUSTOM_OPTEE_OS_PREPARE

# Override the original OP-TEE OS source tree
OPTEE_OS_OVERRIDE_SRCDIR  = $(CUSTOM_OPTEE_OS_SRCDIR)

################################################################################
# Bare-metal application git repo source tree
################################################################################

CUSTOM_BM_APP_SRCDIR  = $(TOPDIR)/custom/bm-app
CUSTOM_BM_APP_GITURL  = https://gitlab.com/riseproject/riscv-optee/bm-app.git
CUSTOM_BM_APP_BRANCH  = rp016_m1

define CUSTOM_BM_APP_PREPARE
	$(call PREPARE_GIT_TREE,$(CUSTOM_BM_APP_SRCDIR),$(CUSTOM_BM_APP_GITURL),$(CUSTOM_BM_APP_BRANCH),BM_APP)
endef

define CUSTOM_BM_APP_BUILD
	@echo "[BR] Building bare-metal app from $(CUSTOM_BM_APP_SRCDIR)..."
	$(MAKE) -C $(CUSTOM_BM_APP_SRCDIR) CROSS_COMPILE=$(TARGET_CROSS)
	@cp $(CUSTOM_BM_APP_SRCDIR)/bm-app.elf $(BINARIES_DIR)/bm-app.elf
endef

define CUSTOM_BM_APP_SCRIPT
	@echo "[BR] Generating start-qemu-bm.sh..."
	@{ \
	    printf '#!/bin/sh\n\n'; \
	    printf 'BINARIES_DIR="$${0%%/*}/"\n\n'; \
	    printf 'cd "$${BINARIES_DIR}"\n\n'; \
	    printf 'mode_serial=true\n'; \
	    printf 'mode_sys_qemu=false\n\n'; \
	    printf 'if $${mode_serial}; then\n'; \
	    printf "    EXTRA_ARGS='-nographic'\n"; \
	    printf 'else\n'; \
	    printf "    EXTRA_ARGS=''\n"; \
	    printf 'fi\n\n'; \
	    printf 'if ! $${mode_sys_qemu}; then\n'; \
	    printf '    export PATH="%s/bin:$${PATH}"\n' "$(HOST_DIR)"; \
	    printf 'fi\n\n'; \
	    printf 'qemu-system-riscv64 \\\n'; \
	    printf '    -M virt \\\n'; \
	    printf '    -cpu rv64,zkr=on \\\n'; \
	    printf '    -m 4096 \\\n'; \
	    printf '    -smp 2 \\\n'; \
	    printf '    -nographic \\\n'; \
	    printf '    -bios fw_jump.bin \\\n'; \
	    printf '    -kernel bm-app.elf \\\n'; \
	    printf '    -serial mon:stdio \\\n'; \
	    printf '    $${EXTRA_ARGS} "$$@"\n'; \
	} > $(BINARIES_DIR)/start-qemu-bm.sh
	@chmod +x $(BINARIES_DIR)/start-qemu-bm.sh
endef

# Add Bare-metal application functions to the post image hooks
TARGET_FINALIZE_HOOKS += CUSTOM_BM_APP_PREPARE
TARGET_FINALIZE_HOOKS += CUSTOM_BM_APP_BUILD
TARGET_FINALIZE_HOOKS += CUSTOM_BM_APP_SCRIPT

