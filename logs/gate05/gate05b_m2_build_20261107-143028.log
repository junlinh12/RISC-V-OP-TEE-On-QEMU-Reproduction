#!/bin/sh

BINARIES_DIR="${0%/*}/"

cd "${BINARIES_DIR}"

mode_serial=true
mode_sys_qemu=false

if ${mode_serial}; then
    EXTRA_ARGS='-nographic'
else
    EXTRA_ARGS=''
fi

if ! ${mode_sys_qemu}; then
    export PATH="<HOME>/projects/RISC-V-OP-TEE-On-QEMU-Reproduction/work/buildroot-m2/output/host/bin:${PATH}"
fi

qemu-system-riscv64 \
    -M virt \
    -cpu rv64,zkr=on \
    -m 4096 \
    -smp 2 \
    -nographic \
    -bios fw_jump.bin \
    -kernel bm-app.elf \
    -serial mon:stdio \
    ${EXTRA_ARGS} "$@"

