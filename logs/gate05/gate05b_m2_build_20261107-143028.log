#!/bin/sh

BINARIES_DIR="${0%/*}/"

CONFIG_DIR="$(cd "${BINARIES_DIR}../../" && pwd)"

cd "${BINARIES_DIR}"

mode_serial=true
mode_sys_qemu=false

if ${mode_serial}; then
    EXTRA_ARGS='-nographic'
else
    EXTRA_ARGS=''
fi

if ! ${mode_sys_qemu}; then
    export PATH="<HOME>/projects/RISC-V-OP-TEE-On-QEMU-Reproduction/work/buildroot-m2/output/host/bin:${PATH}"
fi

qemu-system-riscv64 \
    -M virt,aia=aplic \
    -machine dumpdtb=qemu_base_m2_smp2.dtb \
    -cpu rv64,zkr=on \
    -m 4096 \
    -smp 2 \
    -nographic \
    ${EXTRA_ARGS} "$@"
dtc -@ -I dts -O dtb -o aplic_mmode_wired_irq_test_smp2.dto \
    "${CONFIG_DIR}/custom/opensbi/platform/generic/virt/aplic_mmode_wired_irq_test_smp2.dts" 
fdtoverlay -i qemu_base_m2_smp2.dtb -o qemu_base_m2_mwired_smp2.dtb aplic_mmode_wired_irq_test_smp2.dto 
qemu-system-riscv64 \
    -M virt,aia=aplic \
    -cpu rv64,zkr=on \
    -m 4096 \
    -smp 2 \
    -nographic \
    -dtb qemu_base_m2_mwired_smp2.dtb \
    -bios fw_jump.bin \
    -kernel Image \
    -device virtio-blk-device,drive=hd0 \
    -drive if=none,format=raw,file=sdcard.img,id=hd0 \
    -device virtio-serial-device \
    -chardev socket,id=vc0,host=127.0.0.1,port=64321,server=on,wait=on \
    -device virtconsole,chardev=vc0 \
    -chardev socket,id=vc1,host=127.0.0.1,port=64322,server=on,wait=off \
    -device virtconsole,chardev=vc1 \
    -device virtio-net-pci,netdev=net0 \
    -netdev user,id=net0,hostfwd=tcp::2200-:22 \
    -append "console=hvc0 root=/dev/vda1 rw rootwait" \
    ${EXTRA_ARGS} "$@"

----- output/images/start-qemu.sh -----
#!/bin/sh

BINARIES_DIR="${0%/*}/"
# shellcheck disable=SC2164
cd "${BINARIES_DIR}"

mode_serial=false
mode_sys_qemu=false
while [ "$1" ]; do
    case "$1" in
    --serial-only|serial-only) mode_serial=true; shift;;
    --use-system-qemu) mode_sys_qemu=true; shift;;
    --) shift; break;;
    *) echo "unknown option: $1" >&2; exit 1;;
    esac
done

if ${mode_serial}; then
    EXTRA_ARGS='-nographic'
else
    EXTRA_ARGS=''
fi

if ! ${mode_sys_qemu}; then
    export PATH="<HOME>/projects/RISC-V-OP-TEE-On-QEMU-Reproduction/work/buildroot-m2/output/host/bin:${PATH}"
fi

exec qemu-system-riscv64 -M virt -cpu rv64,zkr=on -dtb qemu_rv64_virt_domain.dtb -m 4096 -smp 2 -semihosting-config enable=on,target=native -serial tcp:127.0.0.1:64320,server -bios u-boot-spl -device loader,file=u-boot.itb,addr=0x80200000 -device virtio-blk-device,drive=hd0 -drive format=raw,file=sdcard.img,id=hd0,if=none -device virtio-net-pci,netdev=net0 -netdev user,id=net0,hostfwd=tcp::2200-:22 -nographic  ${EXTRA_ARGS} "$@"

