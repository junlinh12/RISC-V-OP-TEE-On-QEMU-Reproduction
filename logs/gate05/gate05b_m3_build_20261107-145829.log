#!/bin/sh

BINARIES_DIR="${0%/*}/"
CONFIG_DIR="$(cd "${BINARIES_DIR}../../" && pwd)"

cd "${BINARIES_DIR}"

mode_serial=true
mode_sys_qemu=false

if ${mode_serial}; then
    EXTRA_ARGS='-nographic'
else
    EXTRA_ARGS=''
fi

if ! ${mode_sys_qemu}; then
    export PATH="<HOME>/projects/RISC-V-OP-TEE-On-QEMU-Reproduction/work/buildroot-m3/output/host/bin:${PATH}"
fi

qemu-system-riscv64 \
    -M virt,aia=aplic \
    -cpu rv64,zkr=on \
    -m 4096 \
    -smp 4 \
    -machine dumpdtb=qemu_linux_test_4harts.dtb \
    -device loader,file=bm-app.bin,addr=0x88000000 \
    -device loader,file=bm-app.bin,addr=0x89000000 \
    -nographic \
    -bios fw_jump.bin \
    -kernel Image \
    -device virtio-blk-device,drive=hd0 \
    -drive if=none,format=raw,file=sdcard.img,id=hd0 \
    -device virtio-serial-device \
    -chardev socket,id=vc0,host=127.0.0.1,port=64321,server=on,wait=off \
    -device virtconsole,chardev=vc0 \
    -chardev socket,id=vc1,host=127.0.0.1,port=64322,server=on,wait=off \
    -device virtconsole,chardev=vc1 \
    -device virtio-net-pci,netdev=net0 \
    -netdev user,id=net0,hostfwd=tcp::2200-:22 \
    -append "console=hvc0 root=/dev/vda1 rw rootwait maxcpus=2" \
    ${EXTRA_ARGS} "$@"
dtc -@ -I dts -O dtb -o hwirq_bind_domain_linux_bmapp.dto \
    "${CONFIG_DIR}/custom/opensbi/platform/generic/virt/hwirq_bind_domain_linux_bmapp.dts" 
fdtoverlay -i qemu_linux_test_4harts.dtb -o qemu_linux_test_merge_4harts.dtb hwirq_bind_domain_linux_bmapp.dto 
qemu-system-riscv64 \
